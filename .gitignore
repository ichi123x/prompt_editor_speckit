*.xsd.cs

# OpenCover UI 解析結果
OpenCover/

# Azure Stream Analytics ローカル実行出力
ASALocalRun/

# MSBuild バイナリ・構造化ログ
*.binlog
MSBuild_Logs/

# AWS SAM のビルド・一時アーティファクトフォルダ
.aws-sam

# NVidia Nsight GPU デバッガー設定ファイル
*.nvuser

# MFractors (Xamarin 生産性向上ツール) の作業フォルダ
**/.mfractor/

# Visual Studio のローカル履歴
**/.localhistory/

# Visual Studio 履歴 (VSHistory) ファイル
.vshistory/

# BeatPulse ヘルスチェック用一時データベース
healthchecksdb

# Visual Studio 2017 のパッケージ参照変換ツール用バックアップフォルダ
MigrationBackup/

# Ionide (クロスプラットフォーム F# VS Code ツール) の作業フォルダ
**/.ionide/

# Fody - 自動生成される XML スキーマ
FodyWeavers.xsd

# 複数のツールを併用する人向けの VS Code ファイル
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Visual Studio Code のローカル履歴
.history/

# ビルド済み Visual Studio Code 拡張機能
*.vsix

# ビルド出力の Windows インストーラーファイル
*.cab
*.msi
*.msix
*.msm
*.msp

