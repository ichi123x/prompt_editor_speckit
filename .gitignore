**/.paket/paket.exe
paket-files/

# FAKE - F# Make
**/.fake/

# CodeRush 個人設定
**/.cr/personal

# Python Tools for Visual Studio (PTVS)
**/__pycache__/
*.pyc

# Cake - 使用している場合はコメント解除
#tools/**
#!tools/packages.config

# Tabs Studio
*.tss

# Telerik の JustMock 設定ファイル
*.jmconfig

# BizTalk ビルド出力
*.btp.cs
